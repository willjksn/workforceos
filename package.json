{
  "name": "workforceos",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:phase2": "tsx scripts/test-phase2.ts",
    "test:db-acceptance": "tsx scripts/test-db-acceptance.ts",
    "test:phase3": "tsx scripts/test-phase3.ts",
    "test:phase4": "tsx scripts/test-phase4.ts",
    "test:phase5": "tsx scripts/test-phase5.ts",
    "test:phase6": "tsx scripts/test-phase6.ts",
    "test:phase7": "tsx scripts/test-phase7.ts",
    "test:phase8": "tsx scripts/test-phase8.ts",
    "test:phase9": "tsx scripts/test-phase9.ts",
    "test:phase10": "tsx scripts/test-phase10.ts",
    "test:public-site": "tsx scripts/test-public-site.ts && tsx scripts/test-public-content.ts && npm --prefix sites/pierone test",
    "test:smoke": "tsx scripts/test-smoke.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "tsx scripts/db-check.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:seed:dev": "tsx scripts/seed.ts",
    "db:seed:prod": "tsx scripts/seed-prod.ts",
    "db:bootstrap-admin": "tsx scripts/grant-managing-partner.ts",
    "db:verify-core": "tsx scripts/verify-core-identity.ts",
    "db:verify-extensions": "tsx scripts/verify-extensions.ts",
    "inngest:dev": "npx inngest-cli@latest dev",
    "inngest:health": "tsx scripts/inngest-health.ts",
    "dev:public-site": "npm --prefix sites/pierone run dev",
    "build:public-site": "npm --prefix sites/pierone run build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.901.0",
    "@aws-sdk/s3-request-presigner": "^3.901.0",
    "@clerk/nextjs": "^7.9.1",
    "@neon/config": "^1.3.0",
    "@neon/env": "^1.2.1",
    "@neondatabase/serverless": "^1.1.0",
    "@sentry/node": "^10.74.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "inngest": "^4.20.0",
    "lucide-react": "^1.41.0",
    "mammoth": "^1.12.2",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "unpdf": "^1.8.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.0"
  }
}
