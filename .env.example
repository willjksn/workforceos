# Copy to .env.local and fill in values. Never commit real credentials.

# Application
NODE_ENV=development
APP_VERSION=0.1.0
# Canonical origin for this environment. Local default is http://localhost:3000.
# Preview: https://<preview>.vercel.app
# Production: https://app.pieronepartners.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000
PUBLIC_CAREERS_URL=
PUBLIC_APP_URL=
# Optional HMAC between the PierOne public website and WorkforceOS write APIs.
# When set, anonymous POSTs from other origins must include X-PierOne-Site-Timestamp and X-PierOne-Site-Signature.
PUBLIC_SITE_INTEGRATION_SECRET=
# Comma-separated origins allowed to call public write APIs (in addition to NEXT_PUBLIC_APP_URL).
PUBLIC_SITE_ALLOWED_ORIGINS=http://localhost:3001,https://pieronepartners.com,https://www.pieronepartners.com
# Optional override if more than one organization exists. Leave unset for the default `workforceos` org.
PUBLIC_INTAKE_ORGANIZATION_ID=

# Neon PostgreSQL — required for database scripts, seeds, and acceptance tests.
# DATABASE_URL is the pooled connection (app/runtime).
# DATABASE_URL_UNPOOLED is the direct connection (Drizzle migrations).
# Use a development branch locally. Do not point local tools at a live production database.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=development

# Clerk — required to sign in to /app.
# Local and Preview: test/development keys (pk_test_ / sk_test_).
# Production: live keys on the Vercel Production environment only.
# Invite-only: disable public sign-ups in the Clerk Dashboard.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/app
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/app

# Inngest — optional until background jobs are used.
# Local: npm run inngest:dev
# Vercel: set both keys and register https://<host>/api/inngest in the Inngest dashboard.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Object storage — local adapter is development-only.
# Preview/Production: STORAGE_PROVIDER=s3 plus Cloudflare R2 or other S3-compatible credentials.
# Public resumes use StorageProvider. Binaries are never stored in PostgreSQL.
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=.data/storage
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# AI provider — optional until live completions are enabled.
# Keep the existing AI_* abstraction. Features pick FAST | STANDARD | REASONING | EMBEDDING.
# When AI_API_KEY (or OPENAI_API_KEY) is unset, or AI_PROVIDER=internal_heuristic, runtime is heuristic.
# Development / Preview / Production should use separate keys in Vercel per environment.
# Do not put AI keys in NEXT_PUBLIC_*. Do not invent extra providers.
AI_PROVIDER=
AI_API_KEY=
# Optional OpenAI-compatible alias. Used only when AI_API_KEY is unset.
OPENAI_API_KEY=
# OpenAI-compatible base URL. Default is https://api.openai.com/v1.
# A Neon AI Gateway or other OpenAI-compatible endpoint may be set here; no extra provider brand is added.
AI_BASE_URL=
# Capability-class models. Aliases: OPENAI_MODEL_FAST, OPENAI_MODEL_BALANCED / AI_MODEL, OPENAI_MODEL_PRIMARY, OPENAI_EMBEDDING_MODEL.
AI_MODEL_FAST=
AI_MODEL_STANDARD=
AI_MODEL_REASONING=
AI_MODEL_EMBEDDING=
AI_MODEL=
AI_FALLBACK_MODEL=
OPENAI_MODEL_FAST=
OPENAI_MODEL_BALANCED=
OPENAI_MODEL_PRIMARY=
OPENAI_EMBEDDING_MODEL=

# Monitoring — optional. Sentry is not wired yet; this reserved hook DSN.
SENTRY_DSN=

# Transactional email (Resend). Required in production for application/interview/offer/onboarding mail.
# Tests and local development use MockEmailProvider when these are unset.
# Production with missing keys fails clearly (does not silently "send" via mock).
# DNS (SPF/DKIM/DMARC) is NOT assumed complete. Verify the sending domain in Resend before go-live.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_REPLY_TO_EMAIL=

# Calendar live OAuth scheduling is NOT enabled. Interview events always use MockCalendarProvider.
# Microsoft/Google keys, when set, are Integration Hub workspace references only.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Checkr HTTP API is not wired. Setting CHECKR_API_KEY does not enable live or sandbox checks.
# Manual background-check workflow only. Results never auto-reject.
CHECKR_API_KEY=
CHECKR_WEBHOOK_SECRET=

# Drug screening vendor is not selected. Leave unset. ManualDrugScreenProvider only.
DRUG_SCREEN_PROVIDER=
DRUG_SCREEN_API_KEY=
