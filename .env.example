# Copy to .env.local and fill in values. Never commit real credentials.

# Application
NODE_ENV=development
APP_VERSION=0.1.0
# Canonical origin for this environment. Local default is http://localhost:3000.
# Preview: https://<preview>.vercel.app
# Production: https://app.pieronepartners.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000

# Neon PostgreSQL — required for database scripts, seeds, and acceptance tests.
# DATABASE_URL is the pooled connection (app/runtime).
# DATABASE_URL_UNPOOLED is the direct connection (Drizzle migrations).
# Use a development branch locally. Do not point local tools at a live production database.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=development

# Clerk — required to sign in to /app.
# Local and Preview: test/development keys (pk_test_ / sk_test_).
# Production: live keys on the Vercel Production environment only.
# Invite-only: disable public sign-ups in the Clerk Dashboard.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/app
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/app

# Inngest — optional until background jobs are used.
# Local: npm run inngest:dev
# Vercel: set both keys and register https://<host>/api/inngest in the Inngest dashboard.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Object storage — local adapter is development-only.
# Preview/Production: STORAGE_PROVIDER=s3 plus Cloudflare R2 or other S3-compatible credentials.
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=.data/storage
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# AI provider — optional until agents are enabled.
AI_PROVIDER=
AI_API_KEY=

# Monitoring — optional. Sentry is not wired yet; this reserved hook DSN.
SENTRY_DSN=
