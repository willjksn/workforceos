# Copy to .env.local and fill in values. Never commit real credentials.

# Application
NODE_ENV=development
APP_VERSION=0.1.0

# Neon PostgreSQL — required for database scripts, seeds, and acceptance tests.
# Not required to start `next dev` or `next build` until a page queries the database.
DATABASE_URL=

# Clerk — required to sign in to /app.
# Invite-only: disable public sign-ups in the Clerk Dashboard.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Inngest — optional until background jobs are used.
# Local dev server: npx inngest-cli@latest dev
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Object storage — defaults to the local development adapter when unset.
# Production should use S3-compatible credentials (Cloudflare R2 or equivalent).
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=.data/storage
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# AI provider — optional until agents are enabled.
AI_PROVIDER=
AI_API_KEY=

# Monitoring — optional. Sentry is not wired yet; this reserved hook DSN.
SENTRY_DSN=
