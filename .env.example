# Copy to .env.local and fill in values. Never commit real credentials.

# Application
NODE_ENV=development
APP_VERSION=0.1.0
# Canonical origin for this environment. Local default is http://localhost:3000.
# Preview: https://<preview>.vercel.app
# Production: https://app.pieronepartners.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000
PUBLIC_CAREERS_URL=
PUBLIC_APP_URL=

# Neon PostgreSQL — required for database scripts, seeds, and acceptance tests.
# DATABASE_URL is the pooled connection (app/runtime).
# DATABASE_URL_UNPOOLED is the direct connection (Drizzle migrations).
# Use a development branch locally. Do not point local tools at a live production database.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=development

# Clerk — required to sign in to /app.
# Local and Preview: test/development keys (pk_test_ / sk_test_).
# Production: live keys on the Vercel Production environment only.
# Invite-only: disable public sign-ups in the Clerk Dashboard.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/app
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/app

# Inngest — optional until background jobs are used.
# Local: npm run inngest:dev
# Vercel: set both keys and register https://<host>/api/inngest in the Inngest dashboard.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Object storage — local adapter is development-only.
# Preview/Production: STORAGE_PROVIDER=s3 plus Cloudflare R2 or other S3-compatible credentials.
# Public resumes use StorageProvider. Binaries are never stored in PostgreSQL.
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=.data/storage
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# AI provider — optional until agents are enabled.
AI_PROVIDER=
AI_API_KEY=

# Monitoring — optional. Sentry is not wired yet; this reserved hook DSN.
SENTRY_DSN=

# Transactional email (Resend). Required in production for application/interview/offer/onboarding mail.
# Tests and local development use MockEmailProvider when these are unset.
# Production with missing keys fails clearly (does not silently "send" via mock).
# DNS (SPF/DKIM/DMARC) is NOT assumed complete. Verify the sending domain in Resend before go-live.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_REPLY_TO_EMAIL=

# Calendar live OAuth scheduling is NOT enabled. Interview events always use MockCalendarProvider.
# Microsoft/Google keys, when set, are Integration Hub workspace references only.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Checkr HTTP API is not wired. Setting CHECKR_API_KEY does not enable live or sandbox checks.
# Manual background-check workflow only. Results never auto-reject.
CHECKR_API_KEY=
CHECKR_WEBHOOK_SECRET=

# Drug screening vendor is not selected. Leave unset. ManualDrugScreenProvider only.
DRUG_SCREEN_PROVIDER=
DRUG_SCREEN_API_KEY=
